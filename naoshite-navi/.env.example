# なおしてナビ 環境変数のひな形（Phase 2 から使用。Phase 1 のデモでは不要）
# 実際の値は .env.local（Git 管理外）または Vercel の Environment Variables に設定する。
# このファイルに本物の値を書かないこと。

# Supabase（ブラウザに公開される値。RLS で保護される前提）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用（絶対に NEXT_PUBLIC_ を付けない・クライアントへ渡さない）
SUPABASE_SERVICE_ROLE_KEY=

# 進捗ページのアクセストークン署名用（32文字以上のランダム値）
REQUEST_TOKEN_SECRET=
