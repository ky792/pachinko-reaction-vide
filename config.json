{
  "input_video": "input/1000010320.mp4",
  "output_full": "output/1000010320_voice.mp4",
  "output_test": "output/1000010320_voice_test{seconds}s.mp4",
  "timeline": "scripts/timeline.json",
  "cache_dir": "cache/tts",

  "tts": {
    "engine": "edge-tts",
    "concurrency": 4,
    "retries": 4,
    "voices": {
      "board":    {"voice": "ja-JP-KeitaNeural",  "rate": "+15%", "pitch": "+0Hz",  "volume": "+0%"},
      "rabbit":   {"voice": "ja-JP-NanamiNeural", "rate": "+5%",  "pitch": "+15Hz", "volume": "+0%"},
      "cat":      {"voice": "ja-JP-KeitaNeural",  "rate": "+10%", "pitch": "+25Hz", "volume": "+0%"},
      "narrator": {"voice": "ja-JP-NanamiNeural", "rate": "+10%", "pitch": "+0Hz",  "volume": "+0%"}
    },
    "read_kinds": ["res", "talk", "title", "ending", "subscribe"],
    "replace": {
      "↓": "、",
      "①": "いち", "②": "に", "③": "さん", "④": "よん", "⑤": "ご", "⑥": "ろく", "⑦": "なな", "⑧": "はち",
      "LT": "エルティー",
      "RUSH": "ラッシュ",
      "CU": "シーユー",
      "SNS": "エスエヌエス",
      "YouTube": "ユーチューブ",
      "ワイ": "ワイ"
    }
  },

  "timing": {
    "voice_offset": 0.12,
    "slot_margin": 0.08,
    "max_speedup": 1.5
  },

  "mix": {
    "original_volume": 0.32,
    "voice_volume": 1.0,
    "duck_original_under_voice": 0.75,
    "target_lufs": -15.0,
    "true_peak": -1.5,
    "sample_rate": 44100,
    "audio_bitrate": "192k"
  }
}
