[
 {
  "start": 0.0,
  "dur": 4.184,
  "text": "65%規制時代、\n今思うと地獄すぎたよな",
  "who": "narrator",
  "se": "piko",
  "topic": null
 },
 {
  "start": 4.184,
  "dur": 5.666,
  "text": "2015年、パチンコ業界は\n確変の継続率を最大65%に\n抑える自主規制に合意した",
  "who": "narrator",
  "se": "taiko",
  "topic": "※65%規制とは"
 },
 {
  "start": 9.851,
  "dur": 4.309,
  "text": "これにより以降の新台は\n継続率65%以下での勝負を\n強いられることになった",
  "who": "narrator",
  "se": "pon",
  "topic": "※65%規制とは"
 },
 {
  "start": 14.159,
  "dur": 4.295,
  "text": "メーカー各社は2400発の\n大当たりや小当たりRUSHなど\n出玉で補う工夫を重ねた",
  "who": "narrator",
  "se": "pon",
  "topic": "※65%規制とは"
 },
 {
  "start": 18.454,
  "dur": 4.67,
  "text": "当時を知るパチンカーからは\n今でも「地獄の65%時代」\nとして語り継がれている",
  "who": "narrator",
  "se": "pon",
  "topic": "※65%規制とは"
 },
 {
  "start": 23.124,
  "dur": 5.328,
  "text": "65%で戦えって\n言われてた時代、\n隣に80%の化け物いたよな",
  "who": "board",
  "se": "piko",
  "topic": "※65%時代"
 },
 {
  "start": 28.452,
  "dur": 1.689,
  "text": "今考えたら地獄で草",
  "who": "board",
  "se": "pon",
  "topic": "※65%時代"
 },
 {
  "start": 30.141,
  "dur": 5.183,
  "text": "80%とか普通にあった時代から\n急に65%になるのキツすぎる",
  "who": "board",
  "se": "pon",
  "topic": "※65%時代"
 },
 {
  "start": 35.325,
  "dur": 3.607,
  "text": "319引いて確変も取って\nようやく報われると思ったら",
  "who": "board",
  "se": "pon",
  "topic": "※65%時代"
 },
 {
  "start": 38.932,
  "dur": 3.166,
  "text": "はい即落ち、これ何回\n食らったか分からん",
  "who": "board",
  "se": "shock",
  "topic": "※65%時代"
 },
 {
  "start": 42.098,
  "dur": 3.293,
  "text": "65%って3連したら\nようやっとるレベルやろ",
  "who": "board",
  "se": "pon",
  "topic": "※65%時代"
 },
 {
  "start": 45.391,
  "dur": 1.04,
  "text": "ナギとバクのひとこと",
  "who": "board",
  "se": "shu",
  "topic": "※65%時代"
 },
 {
  "start": 46.431,
  "dur": 9.18,
  "text": "計算すると、65%で\n3回以上続くのは約27%\n3連できたら上出来です",
  "who": "nagi",
  "se": "pon",
  "topic": "※65%時代"
 },
 {
  "start": 55.611,
  "dur": 3.192,
  "text": "3連で上出来って\n夢なさすぎやろ！",
  "who": "baku",
  "se": "piko",
  "topic": "※65%時代"
 },
 {
  "start": 58.803,
  "dur": 5.838,
  "text": "80%なら約51%なので\n体感はまるで違いますね",
  "who": "nagi",
  "se": "pon",
  "topic": "※65%時代"
 },
 {
  "start": 64.641,
  "dur": 4.633,
  "text": "そら隣の80%に\n浮気したなるわ…",
  "who": "baku",
  "se": "pon",
  "topic": "※65%時代"
 },
 {
  "start": 69.274,
  "dur": 3.559,
  "text": "65%しか続かんなら\n一発をデカくすればええ",
  "who": "board",
  "se": "piko",
  "topic": "※2400発で殴る"
 },
 {
  "start": 72.833,
  "dur": 3.449,
  "text": "この時期2400発搭載機\nめっちゃあったよな",
  "who": "board",
  "se": "pon",
  "topic": "※2400発で殴る"
 },
 {
  "start": 76.282,
  "dur": 3.798,
  "text": "慶次Xとか右の50%が\n2400発だったの狂ってる",
  "who": "board",
  "se": "piko",
  "topic": "※2400発で殴る"
 },
 {
  "start": 80.08,
  "dur": 3.634,
  "text": "継続しない代わりに\n一発で箱パンパンにする時代",
  "who": "board",
  "se": "pon",
  "topic": "※2400発で殴る"
 },
 {
  "start": 83.714,
  "dur": 3.108,
  "text": "でも35%通常が\n一生追いかけてくる",
  "who": "board",
  "se": "shock",
  "topic": "※2400発で殴る"
 },
 {
  "start": 86.822,
  "dur": 1.04,
  "text": "ナギとバクのひとこと",
  "who": "board",
  "se": "shu",
  "topic": "※2400発で殴る"
 },
 {
  "start": 87.862,
  "dur": 5.515,
  "text": "続かんなら2400発で\n殴ればええって脳筋すぎやろ！",
  "who": "baku",
  "se": "piko",
  "topic": "※2400発で殴る"
 },
 {
  "start": 93.377,
  "dur": 6.914,
  "text": "慶次Xは右の半分が16R\n1回の重みで勝負する\n設計ですね",
  "who": "nagi",
  "se": "pon",
  "topic": "※2400発で殴る"
 },
 {
  "start": 100.291,
  "dur": 3.066,
  "text": "1発デカくても\n連チャンせんのやろ？",
  "who": "baku",
  "se": "pon",
  "topic": "※2400発で殴る"
 },
 {
  "start": 103.357,
  "dur": 4.669,
  "text": "はい。だから出玉の波は\nかなり荒かったですね",
  "who": "nagi",
  "se": "pon",
  "topic": "※2400発で殴る"
 },
 {
  "start": 108.026,
  "dur": 2.875,
  "text": "継続率上げられんなら\n当たるまで玉増やしたろ",
  "who": "board",
  "se": "piko",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 110.901,
  "dur": 3.462,
  "text": "GANTZの小当たりRUSH\n初見マジで意味分からんかった",
  "who": "board",
  "se": "pon",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 114.362,
  "dur": 3.952,
  "text": "2400発のあと次の当たりまで\nずっと玉増えるの頭おかしい",
  "who": "board",
  "se": "pon",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 118.314,
  "dur": 3.268,
  "text": "規制の中でみんな必死に\n抜け道探してたよな",
  "who": "board",
  "se": "pon",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 121.583,
  "dur": 1.04,
  "text": "ナギとバクのひとこと",
  "who": "board",
  "se": "shu",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 122.623,
  "dur": 2.715,
  "text": "当たってないのに\n玉増えてるやんけ！",
  "who": "baku",
  "se": "piko",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 125.338,
  "dur": 4.271,
  "text": "次の大当たりまで\n小当たりで玉を増やす\n仕組みですね",
  "who": "nagi",
  "se": "pon",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 129.609,
  "dur": 3.452,
  "text": "続かへんなら\n道中で増やす作戦か！",
  "who": "baku",
  "se": "piko",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 133.061,
  "dur": 4.414,
  "text": "65%を守ったまま\n出玉感を足した工夫です",
  "who": "nagi",
  "se": "pon",
  "topic": "※小当たりRUSH"
 },
 {
  "start": 137.475,
  "dur": 2.853,
  "text": "そんな中で出てきたのが\nシンフォギアなんよな",
  "who": "board",
  "se": "piko",
  "topic": "※答え見つかる"
 },
 {
  "start": 140.328,
  "dur": 4.441,
  "text": "1/199で最終決戦あって\n右は7回＋残保留4個です",
  "who": "board",
  "se": "pon",
  "topic": "※答え見つかる"
 },
 {
  "start": 144.769,
  "dur": 2.664,
  "text": "トータル約80%続きます",
  "who": "board",
  "se": "piko",
  "topic": "※答え見つかる"
 },
 {
  "start": 147.433,
  "dur": 2.128,
  "text": "65%どこ行ったんだよ",
  "who": "board",
  "se": "taiko",
  "topic": "※答え見つかる"
 },
 {
  "start": 149.561,
  "dur": 3.077,
  "text": "この頃から一種二種の\n時代始まった感ある",
  "who": "board",
  "se": "pon",
  "topic": "※答え見つかる"
 },
 {
  "start": 152.639,
  "dur": 3.588,
  "text": "65%で真正面から殴り合う必要\nなかったんやなって",
  "who": "board",
  "se": "pon",
  "topic": "※答え見つかる"
 },
 {
  "start": 156.227,
  "dur": 1.04,
  "text": "ナギとバクのひとこと",
  "who": "board",
  "se": "shu",
  "topic": "※答え見つかる"
 },
 {
  "start": 157.267,
  "dur": 5.598,
  "text": "待って、残保留込みで\n約80%ってズルない？",
  "who": "baku",
  "se": "piko",
  "topic": "※答え見つかる"
 },
 {
  "start": 162.865,
  "dur": 7.223,
  "text": "電サポ7回だけなら約64%\nちゃんと65%以下なんです",
  "who": "nagi",
  "se": "pon",
  "topic": "※答え見つかる"
 },
 {
  "start": 170.088,
  "dur": 3.581,
  "text": "残保留で上乗せとか\n頭良すぎやろ！",
  "who": "baku",
  "se": "piko",
  "topic": "※答え見つかる"
 },
 {
  "start": 173.669,
  "dur": 6.281,
  "text": "各社が65%規制の\n“攻略法”を探していた\n時代とも言えますね",
  "who": "nagi",
  "se": "pon",
  "topic": "※答え見つかる"
 },
 {
  "start": 179.95,
  "dur": 4.138,
  "text": "ただこの65%時代\n1台だけ様子のおかしい\n台があった",
  "who": "board",
  "se": "piko",
  "topic": "※時代違い"
 },
 {
  "start": 184.088,
  "dur": 1.04,
  "text": "ナギとバクのひとこと",
  "who": "board",
  "se": "shu",
  "topic": "※時代違い"
 },
 {
  "start": 185.128,
  "dur": 4.958,
  "text": "なあナギ、この時代の新台って\nみんな65%なんやろ？",
  "who": "baku",
  "se": "piko",
  "topic": "※時代違い"
 },
 {
  "start": 190.086,
  "dur": 5.374,
  "text": "はい。2016年4月以降に\n試験を受けた台は\n65%が上限です",
  "who": "nagi",
  "se": "pon",
  "topic": "※時代違い"
 },
 {
  "start": 195.46,
  "dur": 3.811,
  "text": "ほな北斗無双も\n65%やんな？",
  "who": "baku",
  "se": "piko",
  "topic": "※時代違い"
 },
 {
  "start": 199.271,
  "dur": 5.715,
  "text": "いいえ。継続約80%\n電サポ中の半分以上が\n2400発です",
  "who": "nagi",
  "se": "pon",
  "topic": "※時代違い"
 },
 {
  "start": 204.986,
  "dur": 2.405,
  "text": "なんでや！\n同じ時代の台やろ！",
  "who": "baku",
  "se": "piko",
  "topic": "※時代違い"
 },
 {
  "start": 207.391,
  "dur": 5.658,
  "text": "導入は2016年3月\n規制が始まる直前に\n滑り込んだ台なんです",
  "who": "nagi",
  "se": "pon",
  "topic": "※時代違い"
 },
 {
  "start": 213.049,
  "dur": 3.412,
  "text": "ずっる！\nでもさすがに\nすぐ撤去されたやろ？",
  "who": "baku",
  "se": "pon",
  "topic": "※時代違い"
 },
 {
  "start": 216.461,
  "dur": 5.878,
  "text": "いいえ。CR機が撤去される\n2022年まで、約6年間\nホールにいました",
  "who": "nagi",
  "se": "pon",
  "topic": "※時代違い"
 },
 {
  "start": 223.038,
  "dur": 2.6,
  "text": "お前だけ\n時代違うだろ！",
  "who": "baku",
  "se": "impact",
  "topic": "※時代違い"
 },
 {
  "start": 225.788,
  "dur": 1.04,
  "text": "ナギとバクのまとめ",
  "who": "board",
  "se": "shu",
  "topic": "※まとめ"
 },
 {
  "start": 226.828,
  "dur": 7.516,
  "text": "継続率65%の規制のもと\nメーカー各社は出玉や仕組みで\n性能を補う工夫を重ねた",
  "who": "nagi",
  "se": "taiko",
  "topic": "※まとめ"
 },
 {
  "start": 234.345,
  "dur": 6.498,
  "text": "中でもシンフォギアは\n残保留を使う仕組みで\n実質約80%の継続を実現した",
  "who": "nagi",
  "se": "pon",
  "topic": "※まとめ"
 },
 {
  "start": 240.843,
  "dur": 6.565,
  "text": "一方の北斗無双は\n規制前のスペックのまま\n65%時代を最後まで\n生き抜いた",
  "who": "nagi",
  "se": "pon",
  "topic": "※まとめ"
 },
 {
  "start": 247.408,
  "dur": 4.784,
  "text": "結局、北斗無双が\n一番ずるかったってことやな",
  "who": "baku",
  "se": "piko",
  "topic": "※まとめ"
 },
 {
  "start": 252.192,
  "dur": 1.891,
  "text": "…否定はできませんね",
  "who": "nagi",
  "se": "pon",
  "topic": "※まとめ"
 },
 {
  "start": 254.083,
  "dur": 5.899,
  "text": "みんなが一番打った\n65%時代の台、\nコメントで教えてや！",
  "who": "baku",
  "se": "piko",
  "topic": "※まとめ"
 }
]