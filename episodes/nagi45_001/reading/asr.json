{
 "n01-001": {
  "sha1": "2414d05825aa6345bc6e7573fc5a81f49e2831b4",
  "model": "large-v3-turbo",
  "text": "なんで継続率90%って全然続かんねん"
 },
 "n01-002": {
  "sha1": "12677e4e27ee71d1d74ad988cdc06f04f8f42beb",
  "model": "large-v3-turbo",
  "text": "そもそも継続率90%って何年ぐらいするものだと思ってる?"
 },
 "n01-003": {
  "sha1": "86dd78c67c823ab49c24d1c0b47de16d8e9b661e",
  "model": "large-v3-turbo",
  "text": "継続率90%やったら10連ぐらいはするやろ"
